[Unit]
Description=TeamSpeak 6 MusicBot (TS3AudioBot with Yandex Music & Radio)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ts3bot
Group=ts3bot
WorkingDirectory=/opt/ts3audiobot
ExecStart=/opt/ts3audiobot/start.sh
Restart=always
RestartSec=5

# Безопасность и оптимизация ресурсов
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
MemoryMax=384M
CPUQuota=80%

[Install]
WantedBy=multi-user.target
